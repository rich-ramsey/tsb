@article{frischen2007,
  title = {Gaze Cueing of Attention: {{Visual}} Attention, Social Cognition, and Individual Differences},
  author = {Frischen, Alexandra and Bayliss, Andrew P. and Tipper, Steven P.},
  date = {2007},
  journaltitle = {Psychological Bulletin},
  volume = {133},
  number = {4},
  pages = {694--724},
  issn = {0033-2909 (Print); 1939-1455 (Electronic)},
  doi = {10.1037/0033-2909.133.4.694},
  abstract = {During social interactions, people's eyes convey a wealth of information about their direction of attention and their emotional and mental states. This review aims to provide a comprehensive overview of past and current research into the perception of gaze behavior and its effect on the observer. This encompasses the perception of gaze direction and its influence on perception of the other person, as well as gaze-following behavior such as joint attention, in infant, adult, and clinical populations. Particular focus is given to the gaze-cueing paradigm that has been used to investigate the mechanisms of joint attention. The contribution of this paradigm has been significant and will likely continue to advance knowledge across diverse fields within psychology and neuroscience. (PsycINFO Database Record (c) 2009 APA, all rights reserved)},
  keywords = {face perception,gaze cueing,individual differences,joint attention,observer effect,social cognition,visual attention}
}
@article{hookerBrainNetworksAnalyzing2003,
  title = {Brain Networks for Analyzing Eye Gaze},
  author = {Hooker, Christine I. and Paller, Ken A. and Gitelman, Darren R. and Parrish, Todd B. and Mesulam, M. Marsel and Reber, Paul J.},
  date = {2003},
  journaltitle = {Cognitive Brain Research},
  volume = {17},
  number = {2},
  pages = {406--418},
  issn = {0926-6410},
  url = {http://www.sciencedirect.com/science/article/B6SYV-493H3SV-7/2/4e9c65ed3352a98b1b6cde74834f519f},
  abstract = {The eyes convey a wealth of information in social interactions. This information is analyzed by multiple brain networks, which we identified using functional magnetic resonance imaging (MRI). Subjects attempted to detect a particular directional cue provided either by gaze changes on an image of a face or by an arrow presented alone or by an arrow superimposed on the face. Another control condition was included in which the eyes moved without providing meaningful directional information. Activation of the superior temporal sulcus accompanied extracting directional information from gaze relative to directional information from an arrow and relative to eye motion without relevant directional information. Such selectivity for gaze processing was not observed in face-responsive fusiform regions. Brain activations were also investigated while subjects viewed the same face but attempted to detect when the eyes gazed directly at them. Most notably, amygdala activation was greater during periods when direct gaze never occurred than during periods when direct gaze occurred on 40\% of the trials. In summary, our results suggest that increases in neural processing in the amygdala facilitate the analysis of gaze cues when a person is actively monitoring for emotional gaze events, whereas increases in neural processing in the superior temporal sulcus support the analysis of gaze cues that provide socially meaningful spatial information.},
  keywords = {Amygdala,Autism,Emotion,Face perception,fMRI,Joint attention,Schizophrenia,Social cognition,Superior temporal sulcus (STS),Theory of mind}
}
